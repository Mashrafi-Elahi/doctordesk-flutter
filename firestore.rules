rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().roles.isModerator == true)
      );
    }
    
    function isDoctor() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().roles.isDoctor == true)
      );
    }

    function isDoctorManagingOperator() {
      return isDoctor() &&
        getUserData().doctorProfileId != null &&
        exists(/databases/$(database)/documents/doctors/$(getUserData().doctorProfileId)) &&
        get(/databases/$(database)/documents/doctors/$(getUserData().doctorProfileId)).data.claimedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'operatorAssignments', 'updatedAt']) &&
        (!('roles' in request.resource.data) ||
         !('roles' in resource.data) ||
         request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly(['isOperator'])) &&
        (!('isAdmin' in request.resource.data.roles) || request.resource.data.roles.isAdmin == resource.data.roles.isAdmin) &&
        (!('isDoctor' in request.resource.data.roles) || request.resource.data.roles.isDoctor == resource.data.roles.isDoctor);
    }

    // 1. Users Collection
    // Signed-in read; users write only own doc and cannot change roles, doctorProfileId, or operatorAssignments.
    // Doctor can update another user only to assign/remove operator for their own chamber.
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) &&
        (!('roles' in request.resource.data) ||
         (request.resource.data.roles.isAdmin != true &&
          request.resource.data.roles.isDoctor != true &&
          request.resource.data.roles.isOperator != true));
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'doctorProfileId', 'operatorAssignments'])
      ) || isDoctorManagingOperator();
      allow delete: if isAdmin();
    }

    // 2. Doctors Collection
    // Public read; full create/delete admin only.
    // Allow lightweight create/update for rating aggregates on bundled or un-migrated doctors.
    match /doctors/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.keys().hasOnly(['ratingAverage', 'ratingCount', 'updatedAt'])
      );
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.claimedByUid == request.auth.uid) ||
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // 3. Chambers Collection
    // Public read; write by admin or owning doctor.
    match /chambers/{chamberId} {
      allow read: if true;
      allow write: if isAdmin() || (
        isAuthenticated() && (
          (resource != null && resource.data.doctorId != null &&
           exists(/databases/$(database)/documents/doctors/$(resource.data.doctorId)) &&
           get(/databases/$(database)/documents/doctors/$(resource.data.doctorId)).data.claimedByUid == request.auth.uid) ||
          (request.resource.data.doctorId != null &&
           exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)) &&
           get(/databases/$(database)/documents/doctors/$(request.resource.data.doctorId)).data.claimedByUid == request.auth.uid)
        )
      );
    }

    // 4. Appointments Collection
    // Create by patient (own), operator (chamber walk-in), doctor (practice walk-in), or admin.
    // Read/update/delete by patient, doctor, assigned operator, or admin.
    match /appointments/{apptId} {
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (request.resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == request.resource.data.doctorId) ||
        (request.resource.data.chamberId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().operatorAssignments != null &&
         request.resource.data.chamberId in getUserData().operatorAssignments)
      );
      allow read, update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId) ||
        (resource.data.chamberId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().operatorAssignments != null &&
         resource.data.chamberId in getUserData().operatorAssignments)
      );
    }

    // 5. Notifications Collection
    // Any signed-in user can create; only recipient can read/update/delete.
    match /notifications/{notifId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 6. Reviews Collection
    // Public read; create/update/delete only your own review (or admin delete).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.patientUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.patientUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.patientUid == request.auth.uid ||
        isAdmin()
      );
    }

    // 7. Posts and Comments Collection
    // Create as yourself; delete by owner, admin, or moderator.
    // Allow signed-in users to increment/decrement commentsCount and likesCount.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isDoctor() ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likesCount'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isModerator() ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isModerator() ||
          isAdmin()
        );
      }
    }

    // 8. Health Journal Collection (Private, Owner Only)
    match /journal/{entryId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 9. Operator Applications
    match /operator_applications/{appId} {
      allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId)
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.doctorId != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().doctorProfileId == resource.data.doctorId
      );
    }

    // 10. Specialty Matching Feedback
    match /specialty_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Admins Collection
    // Client read own doc only, no client write.
    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // 12. App Configuration and Metadata
    // Public read, no client write.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
