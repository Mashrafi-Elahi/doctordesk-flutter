rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.isAdmin == true);
    }

    // Doctors: Public read. Authenticated users can claim profiles or update aggregate ratings.
    match /doctors/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Chambers: Public read. Authenticated users/operators can manage.
    match /chambers/{chamberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Metadata: Public read for precomputed specialty categories.
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config: Public read. Admin write only.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins: Read own admin doc.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Reviews: Public read. Any authenticated patient/user can review.
    // Author or Admin can edit/delete their review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.patientUid == request.auth.uid ||
        isAdmin()
      );
    }

    // Appointments:
    // Patients see their own appointments. Doctors see their profile appointments.
    // Operators see assigned chamber appointments. Admins see all.
    match /appointments/{apptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Notifications:
    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    // Health Journal: Owner-only.
    match /journal/{entryId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // Users: Owner can read/update. Doctors/admins can manage roles/assignments.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Specialty Matching Feedback
    match /specialty_feedback/{feedbackId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Feed Posts, Real-time Videos, Community Q&A & Doctor Opinions
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null && (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Desk Operator Applications:
    match /operator_applications/{appId} {
      allow read, write: if request.auth != null;
    }
  }
}
