rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRolesMap() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('roles' in getUserData()) &&
        getUserData().roles is map;
    }
    
    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        (hasRolesMap() && getUserData().roles.isModerator == true)
      );
    }
    
    function isDoctor() {
      return isAuthenticated() && (
        isAdmin() ||
        (hasRolesMap() && getUserData().roles.isDoctor == true)
      );
    }

    function isAssignedOperatorFor(chamberId, doctorId) {
      return isAuthenticated() &&
        chamberId != null &&
        doctorId != null &&
        exists(/databases/$(database)/documents/chamber_operators/$(chamberId + '_' + doctorId + '_' + request.auth.uid));
    }

    function isDoctorManagingOperator() {
      return isDoctor() &&
        getUserData().doctorProfileId != null &&
        exists(/databases/$(database)/documents/doctors/$(getUserData().doctorProfileId)) &&
        get(/databases/$(database)/documents/doctors/$(getUserData().doctorProfileId)).data.claimedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'operatorAssignments', 'assignedChambers', 'updatedAt']) &&
        (!('roles' in request.resource.data) ||
         !('roles' in resource.data) ||
         request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly(['isOperator'])) &&
        (!('isAdmin' in request.resource.data.roles) || request.resource.data.roles.isAdmin == resource.data.roles.isAdmin) &&
        (!('isDoctor' in request.resource.data.roles) || request.resource.data.roles.isDoctor == resource.data.roles.isDoctor);
    }

    // 1. Users Collection
    // Signed-in read; users write only own doc and cannot change roles, doctorProfileId, or operatorAssignments.
    // Doctor can update another user only to assign/remove operator for their own chamber.
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) &&
        (!('roles' in request.resource.data) ||
         (request.resource.data.roles.isAdmin != true &&
          request.resource.data.roles.isDoctor != true &&
          request.resource.data.roles.isOperator != true));
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'doctorProfileId', 'operatorAssignments'])
      ) || isDoctorManagingOperator();
      allow delete: if isAdmin();
    }

    // 2. Doctors Collection
    // Public read; full create/delete admin only.
    match /doctors/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.keys().hasOnly(['ratingAverage', 'ratingCount', 'updatedAt'])
      );
      allow update: if isAdmin() ||
        (isAuthenticated() && resource.data.claimedByUid == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'verificationStatus', 'isBmdcVerified', 'verifiedAt', 'verifiedBy',
           'checkedAt', 'checkedBy', 'bmdcVerificationOutcome', 'method', 'sourceUrl',
           'claimStatus', 'claimedByUid'
         ])) ||
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAverage', 'ratingCount', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Manual BMDC reviews are an admin-only, append-only audit record.
    match /doctor_verification_history/{historyId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.verifiedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // 3. Chambers Collection (Canonical Chamber Model)
    // Public read; create and update by admin or owner doctor only.
    // Visiting doctor CANNOT edit chamber hours, details, or other doctors.
    // Patient cannot write chambers.
    match /chambers/{chamberId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.ownerDoctorId != null &&
        getUserData().doctorProfileId == request.resource.data.ownerDoctorId
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.ownerDoctorId != null &&
        getUserData().doctorProfileId == resource.data.ownerDoctorId
      );
      allow delete: if isAdmin();
    }

    // 3b. Chamber Operators Collection
    // Mapping: chamber_operators/{chamberId}_{doctorId}_{operatorUid}
    // Doctors (both owner and visiting) can assign/remove operators for their own doctor profile.
    // Patients cannot write assignments.
    match /chamber_operators/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.doctorId != null &&
        getUserData().doctorProfileId == request.resource.data.doctorId &&
        assignmentId == request.resource.data.chamberId + '_' + request.resource.data.doctorId + '_' + request.resource.data.operatorUid
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        resource.data.doctorId != null &&
        getUserData().doctorProfileId == resource.data.doctorId
      );
    }

    // Active bookings collection: prevents double or multiple active bookings
    match /active_bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        !exists(/databases/$(database)/documents/active_bookings/$(bookingId));
      allow update: if false;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId) ||
        isAssignedOperatorFor(resource.data.chamberId, resource.data.doctorId)
      );
    }

    // 4. Appointments Collection
    // Patient may only create as 'requested'.
    // Doctor reads/manages own requests.
    // Operator reads/manages ONLY requests for the (chamber, doctor) they are assigned to.
    // Operator of Doctor A CANNOT read Doctor B's requests.
    match /appointments/{apptId} {
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'requested' &&
          (!('source' in request.resource.data) || request.resource.data.source == null) &&
          (!('queuePosition' in request.resource.data) || request.resource.data.queuePosition == null) &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (!('doctorProfileId' in getUserData()) ||
           getUserData().doctorProfileId != request.resource.data.doctorId) &&
          (!('operatorAssignments' in getUserData()) ||
           getUserData().operatorAssignments == null ||
           !(request.resource.data.chamberId in getUserData().operatorAssignments)) &&
          !isAssignedOperatorFor(request.resource.data.chamberId, request.resource.data.doctorId)) ||
        isAdmin() ||
        (request.resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == request.resource.data.doctorId &&
         request.resource.data.status != 'requested') ||
        (isAssignedOperatorFor(request.resource.data.chamberId, request.resource.data.doctorId) &&
         request.resource.data.status != 'requested') ||
        (request.resource.data.chamberId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().operatorAssignments != null &&
         request.resource.data.chamberId in getUserData().operatorAssignments &&
         request.resource.data.status != 'requested')
      );
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId) ||
        isAssignedOperatorFor(resource.data.chamberId, resource.data.doctorId)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId) ||
        isAssignedOperatorFor(resource.data.chamberId, resource.data.doctorId) ||
        (resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId) ||
        isAssignedOperatorFor(resource.data.chamberId, resource.data.doctorId)
      );
    }

    // 4c. Doctor Slots (Global reservation locks: doctor_slots/{doctorId}_{yyyyMMdd}_{HHmm})
    match /doctor_slots/{slotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == request.resource.data.doctorId) ||
        isAssignedOperatorFor(request.resource.data.chamberId, request.resource.data.doctorId) ||
        (request.resource.data.chamberId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().operatorAssignments != null &&
         request.resource.data.chamberId in getUserData().operatorAssignments)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId) ||
        isAssignedOperatorFor(resource.data.chamberId, resource.data.doctorId) ||
        (resource.data.chamberId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().operatorAssignments != null &&
         resource.data.chamberId in getUserData().operatorAssignments)
      );
      allow update: if false;
    }

    // 4d. Chamber Day Overrides (chamber_day_overrides/{chamberId}_{yyyyMMdd})
    match /chamber_day_overrides/{overrideId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == request.resource.data.doctorId) ||
        isAssignedOperatorFor(request.resource.data.chamberId, request.resource.data.doctorId) ||
        (request.resource.data.chamberId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().operatorAssignments != null &&
         request.resource.data.chamberId in getUserData().operatorAssignments)
      );
      allow delete: if isAdmin() || (
        resource.data.doctorId != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().doctorProfileId == resource.data.doctorId
      ) || isAssignedOperatorFor(resource.data.chamberId, resource.data.doctorId) || (
        resource.data.chamberId != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().operatorAssignments != null &&
        resource.data.chamberId in getUserData().operatorAssignments
      );
    }

    // 4b. Queue Counter Documents (queues/{chamberId}_{yyyyMMdd})
    match /queues/{queueId} {
      allow read, write: if isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (getUserData().operatorAssignments != null &&
           (resource == null || resource.data.chamberId in getUserData().operatorAssignments ||
            request.resource.data.chamberId in getUserData().operatorAssignments)) ||
          (getUserData().doctorProfileId != null)
        ))
      );
    }

    // 5. Notifications Collection
    match /notifications/{notifId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.recipientId != null && resource.data.recipientId == request.auth.uid)
      );
    }

    // 6. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        (('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
         ('patientUid' in request.resource.data && request.resource.data.patientUid == request.auth.uid)) &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         !('doctorProfileId' in getUserData()) ||
         getUserData().doctorProfileId != request.resource.data.doctorId);
      allow update: if isAuthenticated() && (
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.patientUid != null && resource.data.patientUid == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
        (resource.data.patientUid != null && resource.data.patientUid == request.auth.uid)
      );
    }

    // 7. Posts and Comments Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isDoctor() ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likesCount', 'commentCount', 'viewsCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isModerator() ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isModerator() ||
          isAdmin()
        );
      }
    }

    // 8. Health Journal Collection (Private, Owner Only)
    match /journal/{entryId} {
      allow read, write: if isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    // 9. Operator Applications
    match /operator_applications/{appId} {
      allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isAdmin() ||
        (resource.data.doctorId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId)
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.doctorId != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().doctorProfileId == resource.data.doctorId
      );
    }

    // 10. Specialty Matching Feedback
    match /specialty_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 11. Admins Collection
    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // 12. App Configuration and Metadata
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 13. Claim Requests Collection
    match /claim_requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.applicantUid == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.applicantUid == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }
  
    // 14. Real-time Messaging (Unlocked on Appointment Confirmation)
    // Patient can NEVER create a chat session directly (server/confirm-transaction only).
    // Participants: patient with handling operator, patient with doctor, operator with doctor.
    // Expiry: 7 days after appointment. Message limit enforced.
    // Doctor or operator can close it.
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.doctorUid == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isDoctor() ||
        (hasRolesMap() && getUserData().roles.isOperator == true)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        ((isDoctor() || (hasRolesMap() && getUserData().roles.isOperator == true)) &&
         (request.auth.uid in resource.data.participants || resource.data.doctorUid == request.auth.uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastMessage', 'messageCount'])) ||
        (request.auth.uid in resource.data.participants &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messageCount', 'lastMessage', 'updatedAt']) &&
         request.resource.data.messageCount == resource.data.messageCount + 1)
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isAuthenticated() && (
          isAdmin() ||
          (
            request.resource.data.senderUid == request.auth.uid &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            get(/databases/$(database)/documents/chats/$(chatId)).data.status == 'active' &&
            (!('expiresAt' in get(/databases/$(database)/documents/chats/$(chatId)).data) ||
              request.time < get(/databases/$(database)/documents/chats/$(chatId)).data.expiresAt) &&
            (!('messageLimit' in get(/databases/$(database)/documents/chats/$(chatId)).data) ||
              get(/databases/$(database)/documents/chats/$(chatId)).data.messageCount < get(/databases/$(database)/documents/chats/$(chatId)).data.messageLimit)
          )
        );
        allow update: if isAuthenticated() && (
          isAdmin() ||
          (resource.data.senderUid == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachment', 'updatedAt']))
        );
        allow delete: if isAdmin();
      }
    }

    // 15. Paid Online Consultations
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.patientUid == request.auth.uid ||
        resource.data.doctorUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId)
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.patientUid == request.auth.uid &&
         request.resource.data.status in ['pending_payment', 'paid_unconfirmed'])
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.doctorUid == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().doctorProfileId == resource.data.doctorId) ||
        (resource.data.patientUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trxId', 'paymentMethod', 'status', 'updatedAt']) &&
         request.resource.data.status == 'paid_unconfirmed')
      );
      allow delete: if isAdmin();
    }
  }
}
