{
  "name": "doctordesk-firestore-migration",
  "version": "1.0.0",
  "description": "Firestore data migration scripts for DoctorDesk",
  "main": "migrate_to_firestore.js",
  "scripts": {
    "migrate": "node migrate_to_firestore.js",
    "backfill:chambers": "node migrate_to_firestore.js --chambers-only",
    "bootstrap:owner": "node bootstrap_owner_admin.js",
    "configure:android-google": "node configure_android_google_signin.js",
    "backfill:search-index": "node backfill_search_index.js --apply"
  },
  "dependencies": {
    "csv-parse": "^5.5.0",
    "dotenv": "^16.3.0",
    "firebase-admin": "^12.0.0",
    "geofire-common": "^6.0.0"
  }
}
